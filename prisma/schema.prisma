// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  public
}

enum PartsOfSpeech {
  noun
  verb
  adjective
  adverb
  pronoun
  preposition
  conjunction
  interjection
}

model User {
  id         String   @id @default(uuid())
  name       String
  email      String   @unique
  password   String?
  role       UserRole @default(public)
  isComplete Boolean  @default(false)

  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  hashedToken String    @unique
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  used        Boolean   @default(false)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@map("refresh_tokens")
}

model PresentationCategory {
  id       String @id @default(uuid())
  name     String @unique
  sequence Int

  presentations Presentation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@map("presentation_category")
}

model Presentation {
  id          String  @id @default(uuid())
  title       String  @unique
  text        String
  sequence    Int
  isPublished Boolean @default(true)

  categoryId String
  category   PresentationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@index([categoryId, sequence, createdAt])
  @@map("presentation")
}

model SentenceCategory {
  id       String @id @default(uuid())
  name     String @unique
  sequence Int

  sentences Sentence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@map("sentence_category")
}

model Sentence {
  id          String  @id @default(uuid())
  text        String  @unique
  meaning     String
  whenToUse   String?
  sequence    Int
  isPublished Boolean @default(true)

  categoryId String
  category   SentenceCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  alternates SentenceAlternate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@index([categoryId, sequence, createdAt])
  @@map("sentence")
}

model SentenceAlternate {
  id         String   @id @default(uuid())
  sentenceId String
  sentence   Sentence @relation(fields: [sentenceId], references: [id], onDelete: Cascade)
  text       String
  sequence   Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sentenceId, sequence])
  @@map("sentence_alternate")
}

model ConversationCategory {
  id       String @id @default(uuid())
  name     String @unique
  sequence Int

  conversations Conversation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@map("conversation_category")
}

model Conversation {
  id          String  @id @default(uuid())
  title       String  @unique
  speaker1    String
  speaker2    String
  description String
  sequence    Int
  isPublished Boolean @default(true)

  categoryId String
  category   ConversationCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  lines ConversationLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@index([categoryId, sequence, createdAt])
  @@map("conversation")
}

model ConversationLine {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  text           String
  sequence       Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, sequence])
  @@map("conversation_line")
}

model ListeningCategory {
  id       String @id @default(uuid())
  name     String @unique
  sequence Int

  listenings Listening[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@map("listening_category")
}

model Listening {
  id          String  @id @default(uuid())
  title       String  @unique
  sequence    Int
  isPublished Boolean @default(true)

  categoryId String
  category   ListeningCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  items ListeningItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@index([categoryId, sequence, createdAt])
  @@map("listening")
}

model ListeningItem {
  id          String    @id @default(uuid())
  listeningId String
  listening   Listening @relation(fields: [listeningId], references: [id], onDelete: Cascade)
  text        String
  sequence    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listeningId, sequence])
  @@map("listening_item")
}

model Vocabulary {
  id                     String        @id @default(uuid())
  text                   String        @unique
  meaning                String
  sentence               String
  sentenceMeaning        String
  synonymText            String?
  synonymMeaning         String?
  synonymSentence        String?
  synonymSentenceMeaning String?
  antonymText            String?
  antonymMeaning         String?
  antonymSentence        String?
  antonymSentenceMeaning String?
  sequence               Int
  isPublished            Boolean       @default(true)
  partsOfSpeech          PartsOfSpeech @default(noun)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sequence, createdAt])
  @@map("vocabulary")
}
