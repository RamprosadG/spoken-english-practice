DATABASE_URL=postgres://postgres:password@localhost:5432/spoken_english_practice?schema=public
NODE_ENV=development

# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=replace-with-a-random-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-different-random-secret
HASH_SALT_ROUNDS=10

# Required by the hidden /admin-register page
ADMIN_REGISTER_KEY=replace-with-a-private-admin-key

# Google OAuth client ID from Google Cloud Console (Web application).
# The Google button stays disabled until this is set.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
